<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />
    <meta name="color-scheme" content="light only" />
    <meta name="supported-color-schemes" content="light" />

    <style>
        {{> styles}}
    </style>
</head>

<body bgcolor="#F4F2F7">

<table
    role="presentation"
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    class="background"
    bgcolor="#F4F2F7"
>

<tr>

<td align="center" bgcolor="#F4F2F7">

<table
    role="presentation"
    width="100%"
    class="container"
    cellpadding="0"
    cellspacing="0"
    border="0"
    bgcolor="#FCFBFD"
>

{{> header}}

<tr>

<td class="content" bgcolor="#FCFBFD">

{{{body}}}

</td>

</tr>

{{> footer}}

</table>

</td>

</tr>

</table>

</body>

</html>
