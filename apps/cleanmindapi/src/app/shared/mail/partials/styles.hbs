body {
  margin: 0;
  padding: 0;
  background: #F5F3FF;
  color: #312E81;
  font-family: Inter, Arial, sans-serif;
}

.background {
  width: 100%;
  background: #F5F3FF;
  padding: 40px 12px;
}

.container {
  width: 100%;
  max-width: 600px;
  background: #FFFFFF;
  border-radius: 16px;
  overflow: hidden;
}

.content {
  padding: 40px;
}

h1 {
  margin: 0 0 20px;
  color: #4C1D95;
  font-size: 28px;
  line-height: 1.25;
  text-align: center;
}

p {
  margin: 0 0 20px;
  color: #4B5563;
  font-size: 16px;
  line-height: 1.65;
}

.muted {
  color: #6B7280;
  font-size: 14px;
}

.fallback-link {
  color: #6D28D9;
  font-size: 13px;
  overflow-wrap: anywhere;
}

.verification-code {
  margin: 28px 0;
  color: #5B21B6;
  font-size: 34px;
  font-weight: 700;
  letter-spacing: 8px;
  text-align: center;
}

.task-card {
  margin: 24px 0;
  padding: 20px;
  border-left: 4px solid #7C3AED;
  background: #F5F3FF;
}

.task-card strong,
.task-card span {
  display: block;
}

.task-card strong {
  margin-bottom: 8px;
  color: #4C1D95;
  font-size: 18px;
}

.task-card span {
  color: #6B7280;
  font-size: 14px;
}

.task-card-danger {
  border-left-color: #DC2626;
  background: #FEF2F2;
}

.success-message,
blockquote {
  margin: 24px 0;
  padding: 20px;
  border-radius: 12px;
  background: #F5F3FF;
  color: #5B21B6;
  font-size: 18px;
  line-height: 1.6;
  text-align: center;
}

@media only screen and (max-width: 620px) {
  .background { padding: 0; }
  .container { border-radius: 0; }
  .content { padding: 28px 22px; }
}
