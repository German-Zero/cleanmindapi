:root {
  color-scheme: light only;
  supported-color-schemes: light;
}

html,
body {
  margin: 0;
  padding: 0;
  background: #F4F2F7;
  color: #302C36;
  font-family: Sora, Inter, Arial, sans-serif;
}

.background {
  width: 100%;
  background: #F4F2F7;
  padding: 36px 12px;
}

.container {
  width: 100%;
  max-width: 600px;
  background: #FCFBFD;
  border: 1px solid #E5E0EA;
  border-radius: 18px;
  overflow: hidden;
}

.header {
  padding: 22px 32px;
  background: #FCFBFD;
  border-bottom: 1px solid #ECE8F0;
}

.logo {
  display: block;
  border: 0;
  border-radius: 10px;
}

.brand-mark {
  display: inline-block;
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: #6D4AA0;
  color: #FFFFFF;
  font-size: 18px;
  font-weight: 700;
  line-height: 40px;
  text-align: center;
}

.brand-copy {
  padding-left: 12px;
}

.brand-copy strong,
.brand-copy span {
  display: block;
}

.brand-copy strong {
  color: #342B3E;
  font-size: 16px;
  line-height: 22px;
}

.brand-copy span {
  color: #847C8C;
  font-size: 11px;
  line-height: 17px;
}

.content {
  padding: 38px 40px 34px;
}

.eyebrow {
  margin: 0 0 10px;
  color: #7855A6;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.2px;
  line-height: 16px;
  text-transform: uppercase;
}

h1 {
  margin: 0 0 16px;
  color: #302738;
  font-size: 26px;
  line-height: 34px;
  text-align: left;
}

p {
  margin: 0 0 16px;
  color: #625B69;
  font-size: 14px;
  line-height: 23px;
}

.lead {
  color: #514A58;
  font-size: 15px;
  line-height: 25px;
}

.muted {
  color: #7B7482;
  font-size: 12px;
  line-height: 20px;
}

.fallback-link {
  margin-top: 18px;
  color: #76549F;
  font-size: 11px;
  line-height: 18px;
  overflow-wrap: anywhere;
}

.verification-code {
  margin: 24px 0;
  padding: 20px;
  border: 1px solid #DED4E9;
  border-radius: 12px;
  background: #F7F3FA;
  text-align: center;
}

.verification-code span,
.verification-code strong {
  display: block;
}

.verification-code span {
  margin-bottom: 8px;
  color: #81748C;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1px;
  line-height: 15px;
  text-transform: uppercase;
}

.verification-code strong {
  color: #5D3C87;
  font-size: 30px;
  font-weight: 700;
  letter-spacing: 6px;
  line-height: 38px;
}

.notice {
  margin: 22px 0 0;
  padding: 14px 16px;
  border-radius: 10px;
  background: #F1EEF4;
  color: #6B6372;
  font-size: 12px;
  line-height: 20px;
}

.task-card {
  margin: 22px 0;
  padding: 18px;
  border: 1px solid #DED7E5;
  border-radius: 12px;
  background: #F8F6FA;
}

.task-card strong,
.task-card span {
  display: block;
}

.task-card strong {
  margin-bottom: 6px;
  color: #3F3548;
  font-size: 16px;
  line-height: 24px;
}

.task-card span {
  color: #7B7182;
  font-size: 12px;
  line-height: 19px;
}

.task-card-danger {
  border-color: #E4CBCB;
  background: #FBF5F5;
}

.success-message {
  margin: 22px 0;
  padding: 16px 18px;
  border-radius: 10px;
  background: #F0F7F2;
  color: #3F7451;
  font-size: 14px;
  line-height: 23px;
}

.quote {
  margin: 22px 0;
  padding: 18px 20px;
  border-left: 3px solid #8D6BB5;
  border-radius: 0 10px 10px 0;
  background: #F7F3FA;
  color: #51405F;
  font-size: 17px;
  line-height: 28px;
}

.footer {
  padding: 22px 32px 26px;
  border-top: 1px solid #ECE8F0;
  background: #F8F6FA;
  text-align: center;
}

.footer p {
  margin: 0 0 4px;
  color: #88808F;
  font-size: 10px;
  line-height: 16px;
}

.footer a {
  color: #6D4AA0;
  text-decoration: none;
}

@media only screen and (max-width: 620px) {
  .background {
    padding: 0;
  }

  .container {
    border-right: 0;
    border-left: 0;
    border-radius: 0;
  }

  .header {
    padding: 20px 22px;
  }

  .content {
    padding: 30px 22px 28px;
  }

  .footer {
    padding: 20px 22px 24px;
  }

  h1 {
    font-size: 23px;
    line-height: 31px;
  }
}
