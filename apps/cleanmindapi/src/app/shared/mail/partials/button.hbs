<table
    role="presentation"
    width="100%"
    cellspacing="0"
    cellpadding="0"
    border="0"
    style="margin: 28px 0;"
>
    <tr>
        <td align="left">
            <table
                role="presentation"
                cellspacing="0"
                cellpadding="0"
                border="0"
            >
                <tr>
                    <td
                        align="center"
                        bgcolor="{{buttonColor}}"
                        style="
                            background-color: {{buttonColor}};
                            border-radius: 10px;
                        "
                    >
                        <a
                            href="{{url}}"
                            target="_blank"
                            style="
                                display: inline-block;
                                padding: 13px 22px;
                                font-size: 14px;
                                font-weight: 600;
                                color: #FFFFFF;
                                text-decoration: none;
                                border-radius: 10px;
                            "
                        >
                            {{label}}
                        </a>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
