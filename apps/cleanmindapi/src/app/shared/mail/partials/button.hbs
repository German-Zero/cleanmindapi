<table
    role="presentation"
    cellspacing="0"
    cellpadding="0"
    border="0"
    align="center"
    style="margin: 32px auto;"
>
    <tr>
        <td
            align="center"
            bgcolor="{{buttonColor}}"
            style="
                border-radius: 12px;
            "
        >
            <a
                href="{{url}}"
                target="_blank"
                style="
                    display: inline-block;
                    padding: 14px 28px;
                    font-size: 15px;
                    font-weight: 600;
                    color: #FFFFFF;
                    text-decoration: none;
                    border-radius: 12px;
                "
            >
                {{label}}
            </a>
        </td>
    </tr>
</table>
