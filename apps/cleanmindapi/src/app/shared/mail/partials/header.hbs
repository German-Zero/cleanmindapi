<tr>
  <td class="header" bgcolor="#FCFBFD">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td width="44" valign="middle">
          {{#if logoUrl}}
            <img src="{{logoUrl}}" alt="{{appName}}" width="40" height="40" class="logo" />
          {{else}}
            <span class="brand-mark">C</span>
          {{/if}}
        </td>
        <td valign="middle" class="brand-copy">
          <strong>{{appName}}</strong>
          <span>Mente Limpia, Conciencia Tranquila</span>
        </td>
      </tr>
    </table>
  </td>
</tr>
