// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum PointTransactionType {
  TASK_COMPLETED
  POMODORO_COMPLETED
  STORE_REDEMPTION
  ADMIN_ADJUSTMENT
}

model User {
  id                    String                @id
  name                  String
  email                 String                @unique
  passwordHash          String?
  avatarUrl             String?
  role                  UserRole              @default(USER)
  provider              AuthProvider          @default(LOCAL)
  emailVerified         Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  lastLoginAt           DateTime?
  onboardingCompletedAt DateTime?
  refreshTokens         RefreshToken[]
  verificationTokens    VerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  tasks                 Task[]
  userSettings          UserSettings?
  discordConnection     DiscordConnection?
  discordOAuthStates    DiscordOAuthState[]
  mfaAuthenticator      MfaAuthenticator?
  mfaChallenges         MfaChallenge[]
  pomodoroSettings      PomodoroSettings?
  pomodoroSessions      PomodoroSession[]
  whiteboard            Whiteboard?
  termsAcceptances      UserTermsAcceptance[]
  pointTransactions     PointTransaction[]

  @@map("users")
}

model TermsVersion {
  id          String   @id @default(uuid())
  version     String   @unique
  title       String
  documentUrl String
  effectiveAt DateTime
  createdAt   DateTime @default(now())

  acceptances UserTermsAcceptance[]

  @@index([effectiveAt])
  @@map("terms_versions")
}

model UserTermsAcceptance {
  userId         String
  termsVersionId String
  acceptedAt     DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion TermsVersion @relation(fields: [termsVersionId], references: [id], onDelete: Cascade)

  @@id([userId, termsVersionId])
  @@index([termsVersionId])
  @@map("user_terms_acceptances")
}

model MfaAuthenticator {
  id              String    @id @default(uuid())
  userId          String    @unique
  secretEncrypted String
  enabledAt       DateTime?
  lastUsedStep    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes MfaRecoveryCode[]

  @@map("mfa_authenticators")
}

model MfaRecoveryCode {
  id              String    @id @default(uuid())
  authenticatorId String
  codeHash        String    @unique
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  authenticator MfaAuthenticator @relation(fields: [authenticatorId], references: [id], onDelete: Cascade)

  @@index([authenticatorId])
  @@map("mfa_recovery_codes")
}

model MfaChallenge {
  id            String    @id @default(uuid())
  tokenHash     String    @unique
  userId        String
  expiresAt     DateTime
  attempts      Int       @default(0)
  primaryMethod String
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_challenges")
}

model DiscordConnection {
  id            String   @id @default(uuid())
  userId        String   @unique
  discordUserId String   @unique
  username      String
  globalName    String?
  avatarHash    String?
  connectedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("discord_connections")
}

model DiscordOAuthState {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("discord_oauth_states")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model VerificationToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  userId     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model PointTransaction {
  id        String               @id @default(uuid())
  userId    String
  type      PointTransactionType
  sourceId  String
  amount    Int
  periodKey String               @db.VarChar(7)
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, sourceId])
  @@index([userId, createdAt])
  @@index([userId, periodKey, type])
  @@map("point_transactions")
}

model Task {
  id String @id @default(uuid())

  userId String

  title       String
  description String?

  isImportant Boolean
  isUrgent    Boolean

  quadrant TaskQuadrant
  status   TaskStatus   @default(TODO)

  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pomodoroSessions       PomodoroSession[]
  notificationDeliveries TaskNotificationDelivery[]

  @@index([userId])
}

enum PomodoroSessionStatus {
  ACTIVE
  COMPLETED
  INTERRUPTED
  CANCELLED
}

enum PomodoroBreakType {
  SHORT
  LONG
}

model PomodoroSettings {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  focusMinutes            Int      @default(25)
  shortBreakMinutes       Int      @default(5)
  longBreakMinutes        Int      @default(15)
  sessionsBeforeLongBreak Int      @default(4)
  autoStartBreak          Boolean  @default(false)
  dailyGoalMinutes        Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pomodoro_settings")
}

model PomodoroSession {
  id                       String                @id @default(uuid())
  userId                   String
  taskId                   String?
  status                   PomodoroSessionStatus @default(ACTIVE)
  breakType                PomodoroBreakType     @default(SHORT)
  plannedFocusSeconds      Int
  plannedBreakSeconds      Int
  actualFocusSeconds       Int                   @default(0)
  actualBreakSeconds       Int                   @default(0)
  startedAt                DateTime              @default(now())
  endedAt                  DateTime?
  pausedAt                 DateTime?
  accumulatedPausedSeconds Int                   @default(0)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([taskId])
  @@map("pomodoro_sessions")
}

model Whiteboard {
  id              String   @id @default(uuid())
  userId          String   @unique
  version         Int      @default(3)
  elements        Json
  backgroundImage String?
  savedColors     String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whiteboards")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskQuadrant {
  DO
  PLAN
  DELEGATE
  DELETE
}

enum TaskNotificationKind {
  REMINDER
  OVERDUE
}

model TaskNotificationDelivery {
  id      String               @id @default(uuid())
  taskId  String
  kind    TaskNotificationKind
  dueDate DateTime
  sentAt  DateTime             @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, kind, dueDate])
  @@index([sentAt])
  @@map("task_notification_deliveries")
}

model UserSettings {
  id     String @id @default(uuid())
  userId String @unique

  theme            Theme            @default(LUNAR_MIND)
  backgroundMotion BackgroundMotion @default(NONE)

  emailNotifications    Boolean @default(true)
  whatsappNotifications Boolean @default(false)
  discordNotifications  Boolean @default(false)

  taskNotificationFrequency NotificationFrequency @default(DAILY)

  motivationalMessages Boolean             @default(true)
  motivationFrequency  MotivationFrequency @default(DAILY)

  locale   String @default("es-AR")
  timezone String @default("America/Argentina/Cordoba")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

enum Theme {
  LUNAR_MIND
  DEEP_SERENITY
  CALM_TECH
  SOFT_DAWN
  MINT_BREEZE
  CLEAR_SKY
}

enum BackgroundMotion {
  NONE
  STAR_RAIN
  ORBITAL_GALAXY
  SOFT_AURORA
}

enum NotificationFrequency {
  IMMEDIATE
  DAILY
  WEEKLY
  DISABLED
}

enum MotivationFrequency {
  DAILY
  WEEKLY
  DISABLED
}
